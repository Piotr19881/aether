{
  "name": "qwen2.5-coder",
  "description": "Uses the locally cached Qwen2.5-Coder tokenizer; never downloads a model.",
  "tokenizer": {
    "backend": "huggingface",
    "name": "Qwen/Qwen2.5-Coder-1.5B-Instruct"
  },
  "operators": {
    "|>": ["⊳", "≫", "⟫"],
    "?.": ["⋅", "·"],
    "->": ["→", "⇒"]
  },
  "idioms": {
    "return": ["ret", "rtn"],
    "Tensor": ["Ten", "Tns"]
  },
  "semantic_aliases": {
    "normalize_voltage": ["$1", "$2", "nv"],
    "timestamp": ["$3", "$4", "ts"],
    "centered": ["$5", "$6", "ctr"]
  },
  "alias_candidates": [
    "$1", "$2", "$3", "$4", "$5", "$6", "$7", "$8", "$9",
    "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l",
    "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z"
  ]
}
