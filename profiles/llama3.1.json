{
  "name": "llama3.1",
  "description": "Uses the locally cached Llama 3.1 tokenizer; gated model access may be required.",
  "tokenizer": {
    "backend": "huggingface",
    "name": "meta-llama/Meta-Llama-3.1-8B-Instruct"
  },
  "operators": {
    "|>": ["⟫", "≫", "⊳"],
    "?.": ["·", "⋅"],
    "->": ["⇒", "→"]
  },
  "idioms": {
    "return": ["ret", "rtn"],
    "Tensor": ["Tns", "Ten"]
  },
  "semantic_aliases": {
    "normalize_voltage": ["$1", "$2", "nv"],
    "timestamp": ["$3", "$4", "ts"],
    "centered": ["$5", "$6", "ctr"]
  },
  "alias_candidates": [
    "$1", "$2", "$3", "$4", "$5", "$6", "$7", "$8", "$9",
    "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l",
    "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z"
  ]
}
