{
  "name": "gpt4o-o200k",
  "description": "Exact tiktoken o200k_base measurement (GPT-4o profile).",
  "tokenizer": {
    "backend": "tiktoken",
    "name": "o200k_base"
  },
  "operators": {
    "|>": ["≫", "⟫", "⊳"],
    "?.": ["·", "⋅"],
    "->": ["→", "⇒"]
  },
  "idioms": {
    "return": ["ret", "rtn"]
  },
  "semantic_aliases": {
    "normalize_voltage": ["$1", "$2", "nv"],
    "timestamp": ["$3", "$4", "ts"],
    "centered": ["$5", "$6", "ctr"]
  },
  "alias_candidates": [
    "$1", "$2", "$3", "$4", "$5", "$6", "$7", "$8", "$9",
    "a", "b", "c", "d", "e", "f", "g", "h", "i", "j", "k", "l",
    "m", "n", "o", "p", "q", "r", "s", "t", "u", "v", "w", "x", "y", "z"
  ]
}
